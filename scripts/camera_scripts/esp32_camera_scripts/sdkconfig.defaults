# Common settings. The board comes from the build target:
#   idf.py set-target esp32     (AI-Thinker ESP32-CAM)   + sdkconfig.defaults.esp32
#   idf.py set-target esp32s3   (ESP32-S3 camera board)  + sdkconfig.defaults.esp32s3
# After changing any of these files delete sdkconfig and build again.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# CPU: the timing budget assumes 240 MHz (ESP-IDF default is 160 MHz -> ~1.5x slower)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# PSRAM holds the camera frame buffers and the previous frame; tensor arena stays in internal RAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# speed: optimise for performance, keep logs at INFO
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y

# brownout reset stays on (a half-powered camera gives garbage frames)
CONFIG_ESP_BROWNOUT_DET=y
