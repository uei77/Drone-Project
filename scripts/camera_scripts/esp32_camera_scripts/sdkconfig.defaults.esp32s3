# ESP32-S3-WROOM-1 N8R8 / N16R8 camera boards: 8 MB flash, 8 MB octal PSRAM
# (a board with quad PSRAM, e.g. some N8R2 modules: use CONFIG_SPIRAM_MODE_QUAD=y instead)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# faster PSRAM access for the frame buffers
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
